# --- Local infra (docker-compose.dev.yml via `make bootstrap`) ---
DB_USER=teamrealestate
DB_PASSWORD=teamrealestate
DB_NAME=teamrealestate
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@lesentrecodeurs.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- packages/db (Prisma CLI: generate/migrate, run from the repo root) ---
DATABASE_URL=postgresql://teamrealestate:teamrealestate@localhost:5432/teamrealestate?schema=public

